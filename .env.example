# Backend API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.thecoinchain.com
# Base URL for uploaded media returned by the API
NEXT_PUBLIC_IMAGE_URL=https://api.thecoinchain.com

NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID=

# Google reCAPTCHA v2 (contact + sign-up forms)
NEXT_PUBLIC_reCAPTCHA_SITE_KEY=
# Server-only: never prefix with NEXT_PUBLIC_ (not used by the frontend)
RECAPTCHA_SECRET_KEY=

# CoinGecko demo API keys, rotated on 401/403/429.
# Use the numbered keys and/or a comma-separated list.
NEXT_PUBLIC_COINGECKO_API_KEY_1=
NEXT_PUBLIC_COINGECKO_API_KEY_2=
NEXT_PUBLIC_COINGECKO_API_KEY_3=
NEXT_PUBLIC_COINGECKO_API_KEY_4=
NEXT_PUBLIC_COINGECKO_API_KEYS=
